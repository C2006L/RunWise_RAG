{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
      "^rw-(.*)": "@/components/rw/rw-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "RunWise",
        "navigationBarBackgroundColor": "#0A0A0A",
        "navigationBarTextStyle": "white",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "light"
      }
    },
    {
      "path": "pages/checkin/checkin",
      "style": {
        "navigationBarTitleText": "打卡",
        "navigationBarBackgroundColor": "#0A0A0A",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#0A0A0A"
      }
    },
    {
      "path": "pages/qa/qa",
      "style": {
        "navigationBarTitleText": "答疑",
        "navigationBarBackgroundColor": "#0A0A0A",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#0A0A0A"
      }
    },
    {
      "path": "pages/qa/injury-detail",
      "style": {
        "navigationBarTitleText": "伤病预防",
        "navigationBarBackgroundColor": "#0A0A0A",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#0A0A0A"
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationBarBackgroundColor": "#0A0A0A",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#0A0A0A"
      }
    },
    {
      "path": "pages/checkin/create",
      "style": {
        "navigationBarTitleText": "新建打卡",
        "navigationBarBackgroundColor": "#0A0A0A",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#0A0A0A"
      }
    },
    {
      "path": "pages/mine/profile",
      "style": {
        "navigationBarTitleText": "个人资料",
        "navigationBarBackgroundColor": "#0A0A0A",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#0A0A0A"
      }
    },
    {
      "path": "pages/mine/privacy",
      "style": {
        "navigationBarTitleText": "隐私政策",
        "navigationBarBackgroundColor": "#0A0A0A",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#0A0A0A"
      }
    },
    {
      "path": "pages/mine/agreement",
      "style": {
        "navigationBarTitleText": "用户协议",
        "navigationBarBackgroundColor": "#0A0A0A",
        "navigationBarTextStyle": "white",
        "backgroundColor": "#0A0A0A"
      }
