{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "RunWise",
        "navigationBarBackgroundColor": "#F6F7F9",
        "navigationBarTextStyle": "black",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/checkin/checkin",
      "style": {
        "navigationBarTitleText": "打卡"
      }
    },
    {
      "path": "pages/qa/qa",
      "style": {
        "navigationBarTitleText": "答疑"
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/checkin/create",
      "style": {
        "navigationBarTitleText": "新建打卡"
      }
    },
    {
      "path": "pages/mine/profile",
      "style": {
        "navigationBarTitleText": "个人资料"
      }
    },
    {
      "path": "pages/mine/privacy",
      "style": {
        "navigationBarTitleText": "隐私政策"
      }
    },
    {
      "path": "pages/mine/agreement",
      "style": {
        "navigationBarTitleText": "用户协议"
      }
    },
    {
      "path": "pages/mine/notifications",
      "style": {
        "navigationBarTitleText": "消息通知"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "RunWise",
    "navigationBarBackgroundColor": "#F5F7FA",
    "backgroundColor": "#F5F7FA"
  },
  "tabBar": {
    "color": "#666666",
    "selectedColor": "#FF8A65",
    "backgroundColor": "rgba(255,255,255,0.9)",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "/static/tabbar/home.png",
        "selectedIconPath": "/static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/checkin/checkin",
        "text": "打卡",
        "iconPath": "/static/tabbar/checkin.png",
        "selectedIconPath": "/static/tabbar/checkin-active.png"
      },
      {
        "pagePath": "pages/qa/qa",
        "text": "答疑",
        "iconPath": "/static/tabbar/qa.png",
        "selectedIconPath": "/static/tabbar/qa-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "/static/tabbar/mine.png",
        "selectedIconPath": "/static/tabbar/mine-active.png"
      }
    ]
  }
}