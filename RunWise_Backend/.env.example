# 此文件只列出变量名。不要把真实密码或密钥提交到 Git。

# 服务端口（本机 8080 被其他项目占用）
SERVER_PORT=8081

# 必填：MySQL。MYSQL_URL / MYSQL_USERNAME / MYSQL_PASSWORD 仍可作为覆盖项。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=runwise
DB_USERNAME=runwise_app
DB_PASSWORD=replace_with_your_local_password

# 必填：至少 32 个字符；开发、测试、生产环境分别使用不同密钥
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_chars

# Redis（无密码的本地 Redis 可保留空值）
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DATABASE=0
REDIS_PASSWORD=

# 微信小程序登录
WECHAT_APPID=
WECHAT_SECRET=

# AI / RAG
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
RAG_BASE_URL=http://localhost:5000
RAG_ENABLED=true

# 可选：对象存储
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_STS_ROLE_ARN=

# 可选：本地图片目录
RUNWISE_UPLOAD_DIR=uploads
