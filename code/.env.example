# 默认为本地模型。只有显式改为 compatible 才会使用云 API。
LLM_PROVIDER=ollama
# compatible 模式必填，地址填到 /v1 等基础路径，不带 /chat/completions。
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
# 兼容供应商普遍支持 json_object；仅确认支持严格 JSON Schema 后改为 json_schema。
LLM_JSON_MODE=json_object
# 默认不向兼容 API 发送思考参数；GLM-4.7-Flash 可设置 disabled 减少等待。
LLM_THINKING=default
# 单次模型请求 1~70 秒，外层 Spring/前端分别为 85/100 秒。
LLM_TIMEOUT_SECONDS=70
# 可选输出预算：本地默认问答1000/计划1100；compatible默认2400/1800。
# LLM_CHAT_MAX_TOKENS=2400
# LLM_PLAN_MAX_TOKENS=1800

# Spring Boot 调用的本地 RAG API 默认使用 Ollama，无需云端 API Key
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
RAG_HOST=127.0.0.1
RAG_PORT=5000
RAG_TOP_K=3
RAG_RECALL_SIZE=12
# Chroma cosine distance 越小越相关；用于过滤明显无关的语义召回。
RAG_MAX_VECTOR_DISTANCE=0.82
